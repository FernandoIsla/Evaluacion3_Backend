                                {
                                    "key": "token",
                                    "value": "{{access_token}}",
                                    "type": "string"
                                }
                            ]
                        },
                        "method": "GET",
                        "url": {
                            "raw": "{{base_url}}/pacientes/99999999-9/",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "pacientes",
                                "99999999-9",
                                ""
                            ]
                        }
                    }
                }
            ]
        }
    ]
}